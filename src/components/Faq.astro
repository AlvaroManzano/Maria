---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<section id="faq" class="section section--wash faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <h2 id="faq-title">{t.faq.title}</h2>
    <div class="faq__list">
      {t.faq.items.map((item) => (
        <details>
          <summary><span>{item.q}</span></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr); gap: clamp(1.5rem, 5vw, 5rem); }
  .faq__list { border-top: 1px solid var(--ink); }
  details { border-bottom: 1px solid var(--rule); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 1rem; padding: 1.25rem 0; font-family: var(--serif); font-size: var(--step-1); line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; flex: none; font-family: var(--sans); font-weight: 300; font-size: 1.6rem; line-height: 1; color: var(--lavender-deep); transition: transform 0.25s; }
  details[open] summary::after { transform: rotate(45deg); }
  summary:hover { color: var(--lavender-deep); }
  details p { padding: 0 2.5rem 1.5rem 0; color: var(--ink-soft); max-width: 40rem; }
  @media (max-width: 52rem) { .faq__grid { grid-template-columns: 1fr; } }
</style>
