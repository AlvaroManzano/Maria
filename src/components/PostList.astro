---
import { withBase, blogPostPath, useTranslations, type Lang } from '../i18n';
import { postSlug, readingMinutes, formatDate, type Post } from '../lib/blog';
interface Props { lang: Lang; posts: Post[]; headingLevel?: 'h2' | 'h3' }
const { lang, posts, headingLevel: H = 'h2' } = Astro.props;
const t = useTranslations(lang);
---
<ul class="posts">
  {posts.map((post) => (
    <li>
      <a href={withBase(blogPostPath(lang, postSlug(post)))}>
        <H class="posts__title">{post.data.title}</H>
        <p class="posts__desc">{post.data.description}</p>
        <p class="posts__meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>, {readingMinutes(post)} {t.blog.minRead}</p>
      </a>
    </li>
  ))}
</ul>

<style>
  .posts { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .posts li { border-bottom: 1px solid var(--rule); }
  .posts a { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); column-gap: clamp(1.5rem, 4vw, 4rem); padding: 1.75rem 0; text-decoration: none; color: var(--ink); }
  .posts__title { font-size: var(--step-2); font-weight: 400; grid-row: span 2; }
  .posts a:hover .posts__title { color: var(--lavender-deep); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .posts__desc { color: var(--ink-soft); }
  .posts__meta { margin-top: 0.6rem; font-size: var(--step--1); color: var(--ink-soft); }
  @media (max-width: 48rem) {
    .posts a { grid-template-columns: 1fr; }
    .posts__title { grid-row: auto; margin-bottom: 0.6rem; }
  }
</style>
