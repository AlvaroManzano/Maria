---
import AccentMark from './AccentMark.astro';
interface Props { href: string; inverted?: boolean }
const { href, inverted = false } = Astro.props;
---
<a href={href} class:list={['logo', { 'logo--inverted': inverted }]}>
  <span class="logo__text">Psicología con <span class="logo__a">A<AccentMark class="logo__mark" /></span>cento</span>
</a>

<style>
  .logo { display: inline-flex; text-decoration: none; color: var(--ink); }
  .logo--inverted { color: var(--paper); }
  .logo__text { font-family: var(--serif); font-size: 1.375rem; line-height: 1; letter-spacing: -0.01em; white-space: nowrap; padding-top: 0.35rem; }
  .logo__a { position: relative; display: inline-block; }
  .logo__a :global(.logo__mark) { position: absolute; width: 0.62em; left: 0.3em; top: -0.42em; }
  .logo__a :global(.logo__mark path) { stroke-width: 11; }
</style>
