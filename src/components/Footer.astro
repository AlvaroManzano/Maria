---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { href, useTranslations, type Lang } from '../i18n';
import { site } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <Logo href={href('home', lang)} inverted />
        <p class="site-footer__tagline">{t.footer.tagline}</p>
      </div>
      <nav aria-label={t.nav.menu}>
        <ul>
          <li><a href={href('home', lang, '#about')}>{t.nav.about}</a></li>
          <li><a href={href('home', lang, '#services')}>{t.nav.services}</a></li>
          <li><a href={href('home', lang, '#fees')}>{t.nav.fees}</a></li>
          <li><a href={href('blog', lang)}>{t.nav.blog}</a></li>
          <li><a href={href('book', lang)}>{t.nav.book}</a></li>
        </ul>
      </nav>
      <ul class="site-footer__contact">
        <li><a href={site.whatsapp} rel="noopener" target="_blank"><Icon name="whatsapp" />WhatsApp</a></li>
        <li><a href={`mailto:${site.email}`}><Icon name="mail" />{site.email}</a></li>
        <li><a href={site.instagram} rel="noopener" target="_blank"><Icon name="instagram" />{site.instagramHandle}</a></li>
      </ul>
    </div>
    <p class="site-footer__emergency">{t.footer.emergency}</p>
    <div class="site-footer__bottom">
      <p>© {year} {site.person}, {site.name}.{site.colegiada && <> {t.footer.colegiada}: {site.colegiada}.</>}</p>
      <p><a href={href('privacy', lang)}>{t.footer.privacy}</a> <a href={href('legal', lang)}>{t.footer.legal}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #d9d2e6; padding-block: 4rem 2rem; font-size: var(--step--1); }
  .site-footer a { color: #f3effa; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; text-decoration-color: var(--lavender); }
  .site-footer__grid { display: grid; gap: 2.5rem; grid-template-columns: 1.4fr 1fr 1.2fr; }
  .site-footer__tagline { margin-top: 1rem; max-width: 22rem; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .site-footer__contact a { display: inline-flex; align-items: center; gap: 0.6rem; }
  .site-footer__contact :global(svg) { width: 1.1rem; height: 1.1rem; }
  .site-footer__emergency { margin-top: 3rem; padding: 1rem 1.25rem; border: 1px solid #4a3f5a; border-radius: var(--radius); }
  .site-footer__bottom { margin-top: 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; color: #a99fbb; }
  .site-footer__bottom a { color: #d9d2e6; margin-left: 1.25rem; }
  .site-footer__bottom a:first-child { margin-left: 0; }
  @media (max-width: 48rem) { .site-footer__grid { grid-template-columns: 1fr; } }
</style>
