---
import Icon from './Icon.astro';
import { href, useTranslations, type Lang } from '../i18n';
import { site } from '../config';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const c = t.contact;
// Con Formspree configurado, el formulario se envía allí; si no, abre el correo del visitante con el mensaje ya escrito.
const action = site.formspreeId ? `https://formspree.io/f/${site.formspreeId}` : `mailto:${site.email}`;
---
<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div>
      <h2 id="contact-title">{c.title}</h2>
      <p class="contact__intro">{c.intro}</p>
      <a class="btn btn--whatsapp" href={site.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" />{c.whatsapp}</a>
      <p class="contact__alt">{c.emailLabel}: <a class="link-quiet" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>

    <form
      class="form"
      action={action}
      method="post"
      enctype={site.formspreeId ? undefined : 'text/plain'}
      data-mode={site.formspreeId ? 'formspree' : 'mailto'}
      data-email={site.email}
      data-subject={c.mailSubject}
      data-sending={c.sending}
    >
      <div class="form__row">
        <label>
          <span>{c.name}</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          <span>{c.email}</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
      </div>
      <label>
        <span>{c.topic}</span>
        <select name="topic">
          {c.topicOptions.map((o) => <option>{o}</option>)}
        </select>
      </label>
      <label>
        <span>{c.message}</span>
        <textarea name="message" rows="5" required aria-describedby="message-hint"></textarea>
        <small id="message-hint">{c.messageHint}</small>
      </label>
      <label class="form__check">
        <input type="checkbox" name="privacy" required />
        <span>{c.privacy} <a href={href('privacy', lang)}>{c.privacyLink}</a>.</span>
      </label>
      <input type="hidden" name="_language" value={lang} />
      <button class="btn btn--primary" type="submit">{c.send}</button>
      <p class="form__status" role="status" aria-live="polite" hidden data-success={c.success} data-error={c.error}></p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('form.form');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const status = form.querySelector<HTMLElement>('.form__status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.textContent;

    if (form.dataset.mode === 'mailto') {
      const body = `${data.get('message')}\n\n${data.get('name')} <${data.get('email')}>\n${data.get('topic')}`;
      window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(form.dataset.subject ?? '')}&body=${encodeURIComponent(body)}`;
      return;
    }

    button.disabled = true;
    button.textContent = form.dataset.sending ?? label;
    try {
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = status.dataset.success ?? '';
      status.dataset.state = 'ok';
    } catch {
      status.textContent = status.dataset.error ?? '';
      status.dataset.state = 'error';
    } finally {
      status.hidden = false;
      button.disabled = false;
      button.textContent = label;
    }
  });
</script>

<style>
  .contact__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: start; }
  .contact__intro { margin: 1rem 0 2rem; font-size: var(--step-1); line-height: 1.5; color: var(--ink-soft); max-width: 26rem; }
  .contact__alt { margin-top: 1.25rem; color: var(--ink-soft); overflow-wrap: anywhere; }

  .form { display: grid; gap: 1.25rem; }
  .form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .form label { display: grid; gap: 0.4rem; font-size: var(--step--1); font-weight: 600; }
  .form input:not([type='checkbox']), .form select, .form textarea {
    width: 100%; font: 400 var(--step-0)/1.4 var(--sans); color: var(--ink);
    background: #fff; border: 1px solid #cdb49a; border-radius: 0.5rem; padding: 0.75rem 0.9rem;
  }
  .form textarea { resize: vertical; min-height: 8rem; }
  .form input:focus, .form select:focus, .form textarea:focus { outline: 2px solid var(--lavender-deep); outline-offset: 1px; border-color: var(--lavender-deep); }
  .form small { font-weight: 400; color: var(--ink-soft); }
  .form__check { grid-template-columns: auto 1fr; align-items: start; font-weight: 400 !important; }
  .form__check input { width: 1.15rem; height: 1.15rem; margin-top: 0.15rem; accent-color: var(--lavender-deep); }
  .form .btn { justify-self: start; }
  .form__status { padding: 0.9rem 1rem; border-radius: 0.5rem; background: var(--wash); }
  .form__status[data-state='error'] { background: #fbe9e7; color: #8a2c1c; }
  @media (max-width: 52rem) {
    .contact__grid { grid-template-columns: 1fr; }
    .form__row { grid-template-columns: 1fr; }
  }
</style>
