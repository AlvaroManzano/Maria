---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<section id="about" class="section about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div>
      <h2 id="about-title">{t.about.title}</h2>
      <div class="about__body">
        {t.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <dl class="about__facts">
      {t.about.facts.map(([k, v]) => (
        <div><dt>{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: end; }
  .about h2 { max-width: 18ch; }
  .about__body { margin-top: 2rem; display: grid; gap: 1.1rem; max-width: 38rem; }
  .about__facts { margin: 0; border-top: 1px solid var(--ink); }
  .about__facts div { padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .about__facts dt { font-size: var(--step--1); color: var(--ink-soft); }
  .about__facts dd { margin: 0.15rem 0 0; font-family: var(--serif); font-size: var(--step-1); }
  @media (max-width: 52rem) { .about__grid { grid-template-columns: 1fr; } }
</style>
