---
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n';
interface Props { lang: Lang; title: string; heading: string; alternates: Partial<Record<Lang, string>>; noindex?: boolean }
const { lang, title, heading, alternates, noindex } = Astro.props;
---
<Base lang={lang} title={title} description={heading} alternates={alternates} noindex={noindex}>
  <section class="section">
    <div class="wrap">
      <h1 class="text-title">{heading}</h1>
      <div class="prose"><slot /></div>
    </div>
  </section>
</Base>

<style>
  .text-title { font-size: var(--step-3); margin-bottom: 2.5rem; max-width: 20ch; }
</style>
