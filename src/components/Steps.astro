---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<section class="section section--wash steps" aria-labelledby="steps-title">
  <div class="wrap">
    <h2 id="steps-title" class="section-head">{t.steps.title}</h2>
    <ol class="steps__list">
      {t.steps.items.map((s, i) => (
        <li><span class="steps__n" aria-hidden="true">{i + 1}</span><h3>{s.title}</h3><p>{s.text}</p></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 3.5rem); counter-reset: none; }
  .steps__n { display: block; font-family: var(--serif); font-size: var(--step-4); line-height: 1; color: var(--lavender-deep); font-weight: 300; margin-bottom: 0.75rem; }
  .steps__list h3 { font-size: var(--step-2); font-weight: 400; }
  .steps__list p { margin-top: 0.5rem; color: var(--ink-soft); }
  @media (max-width: 52rem) { .steps__list { grid-template-columns: 1fr; } }
</style>
