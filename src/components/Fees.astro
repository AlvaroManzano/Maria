---
import { useTranslations, type Lang } from '../i18n';
import { prices, site } from '../config';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
const eur = (n: number) => new Intl.NumberFormat(t.htmlLang, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
const r = t.fees.rows;
const rows = [
  { ...r.orientation, price: t.fees.free, pack: null },
  { ...r.individual, price: eur(prices.individual), pack: eur(prices.individualPack) },
  { ...r.students, price: eur(prices.students), pack: eur(prices.studentsPack) },
  { ...r.deepDive, price: eur(prices.deepDive), pack: null },
];
---
<section id="fees" class="section fees" aria-labelledby="fees-title">
  <div class="wrap fees__grid">
    <div class="section-head">
      <h2 id="fees-title">{t.fees.title}</h2>
      <p>{t.fees.intro}</p>
    </div>
    <div>
      <ul class="fees__list">
        {rows.map((row) => (
          <li>
            <div>
              <h3>{row.name}</h3>
              <p>{row.desc}</p>
            </div>
            <div class="fees__price">
              <strong>{row.price}</strong>
              {row.pack && <span>{t.fees.packLabel}: {row.pack} {t.fees.perSession}</span>}
            </div>
          </li>
        ))}
      </ul>
      <p class="fees__note">{t.fees.note}</p>
      <a class="btn btn--primary fees__cta" href={site.whatsapp} target="_blank" rel="noopener">{t.hero.cta}</a>
    </div>
  </div>
</section>

<style>
  .fees__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr); gap: clamp(1rem, 5vw, 5rem); }
  .fees__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
  .fees__list li { display: flex; justify-content: space-between; gap: 1.5rem; padding: 1.5rem 0; border-bottom: 1px solid var(--rule); }
  .fees__list h3 { font-size: var(--step-1); }
  .fees__list p { margin-top: 0.3rem; color: var(--ink-soft); font-size: var(--step--1); max-width: 28rem; }
  .fees__price { text-align: right; flex: none; }
  .fees__price strong { display: block; font-family: var(--serif); font-weight: 400; font-size: var(--step-2); line-height: 1.1; font-variant-numeric: lining-nums; }
  .fees__price span { display: block; margin-top: 0.3rem; font-size: var(--step--1); color: var(--ink-soft); max-width: 13rem; }
  .fees__note { margin-top: 1.5rem; color: var(--ink-soft); font-size: var(--step--1); }
  .fees__cta { margin-top: 1.75rem; }
  @media (max-width: 52rem) { .fees__grid { grid-template-columns: 1fr; } }
  @media (max-width: 36rem) {
    .fees__list li { flex-direction: column; gap: 0.6rem; }
    .fees__price { text-align: left; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; }
    .fees__price span { margin-top: 0; max-width: none; }
  }
</style>
