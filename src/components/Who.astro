---
import { useTranslations, type Lang } from '../i18n';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<section class="section section--wash who" aria-labelledby="who-title">
  <div class="wrap">
    <h2 id="who-title" class="section-head">{t.who.title}</h2>
    <ul class="who__list">
      {t.who.items.map((q) => <li><q>{q}</q></li>)}
    </ul>
    <p class="who__outro">{t.who.outro}</p>
  </div>
</section>

<style>
  .who__list { list-style: none; margin: 0; padding: 0; columns: 2 22rem; column-gap: clamp(2rem, 5vw, 5rem); }
  .who__list li { break-inside: avoid; padding: 1.1rem 0 1.1rem 1.5rem; position: relative; font-family: var(--serif); font-style: italic; font-size: var(--step-2); line-height: 1.25; }
  .who__list q { quotes: none; }
  .who__list li::before { content: '“'; position: absolute; left: 0; top: 0.85rem; color: var(--lavender); font-size: 1.5em; line-height: 1; font-style: normal; }
  .who__outro { margin-top: 2.5rem; max-width: 40rem; font-size: var(--step-1); line-height: 1.5; color: var(--ink-soft); }
</style>
