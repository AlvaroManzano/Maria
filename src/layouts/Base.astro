---
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import serifFont from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import sansFont from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { langs, defaultLang, useTranslations, withBase, type Lang } from '../i18n';
import { site } from '../config';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Ruta de esta misma página en cada idioma (sin base). Si falta un idioma, el selector lleva a su portada. */
  alternates: Partial<Record<Lang, string>>;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  noindex?: boolean;
}

const { lang, title, description, alternates, ogType = 'website', jsonLd = [], noindex = false } = Astro.props;
const t = useTranslations(lang);
const abs = (path: string) => new URL(withBase(path), Astro.site).href;
const canonical = abs(alternates[lang] ?? Astro.url.pathname);
const ogImage = abs(`/og-${lang}.png`);
const hreflangs = langs.filter((l) => alternates[l]).map((l) => ({ lang: l, href: abs(alternates[l]!) }));
const xDefault = alternates[defaultLang] ? abs(alternates[defaultLang]!) : undefined;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    {!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#faf8fc" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFab lang={lang} />
  </body>
</html>
